
{
    "manifest_version": 3,
    "name": "PhishGuard",
    "version": "1.0",
    "description": "Real-time phishing detection with explainable risk score",
    "permissions": ["webNavigation", "storage", "activeTab"],
    "host_permissions": ["<all_urls>"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
    }],
    "action": {
    "default_popup": "popup.html"
}
}